# Copy this file to .env and fill in your own values. Never commit .env.

# Only needed to download fresh swap data; the pinned snapshot tables in data/ work without it.
NEAR_INTENTS_JWT=

# Only needed to re-run the BigQuery SQL in sql/ (pipeline/bq_run.py).
# Your Google Cloud project ID (BigQuery Sandbox is fine, no billing needed).
BQ_PROJECT=
# Dataset created in your project for helper tables (us-east1, where the NEAR public data lives).
BQ_DATASET=near_thesis_e1
